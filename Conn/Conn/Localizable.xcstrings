    "删除主机": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Delete Host"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ホストを削除"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "호스트 삭제"
          }
        },
        "zh-Hant": {
