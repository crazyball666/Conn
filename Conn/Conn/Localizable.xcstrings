        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "데이터는 이 기기와 본인 iCloud에만 저장 · 계정 없음 · 업로드 없음"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "資料僅存本機與你自己的 iCloud · 無帳號 · 零上傳"
