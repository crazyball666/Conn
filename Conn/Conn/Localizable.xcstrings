    "Docker 守护进程未运行。\n请在服务器上启动：\nsudo systemctl start docker": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The Docker daemon isn't running.\nStart it on the server:\nsudo systemctl start docker"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Docker デーモンが起動していません。\nサーバーで起動してください：\nsudo systemctl start docker"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Docker 데몬이 실행 중이 아닙니다.\n서버에서 시작하세요:\nsudo systemctl start docker"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Docker 守護行程未執行。\n請在伺服器上啟動：\nsudo systemctl start docker"
          }
        }
      }
    },
