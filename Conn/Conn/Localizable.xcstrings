    "删除容器 %@？此操作不可撤销（docker rm -f）。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Delete container %@? This cannot be undone (docker rm -f)."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "コンテナ %@ を削除しますか？元に戻せません（docker rm -f）。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "컨테이너 %@를 삭제하시겠습니까? 되돌릴 수 없습니다(docker rm -f)."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "刪除容器 %@？此操作無法復原（docker rm -f）。"
          }
        }
      }
    },
    "免费版已用 %d/%d 台主机，升级专业版解锁无限主机": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Free plan: %d/%d hosts used. Upgrade to Pro for unlimited hosts."
          }
        },
        "ja": {
          "stringUnit": {
