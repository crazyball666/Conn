            "value": "刪除主機"
          }
        }
      }
    },
    "「%@」将从列表中移除，可随时重新添加（不影响服务器本身）。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” will be removed from the list. You can add it again anytime (the server itself is unaffected)."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「%@」はリストから削除されます。いつでも再追加できます（サーバー自体には影響しません）。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "'%@'이(가) 목록에서 제거됩니다. 언제든지 다시 추가할 수 있습니다(서버 자체에는 영향을 주지 않습니다)."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "「%@」將從清單中移除，可隨時重新新增（不影響伺服器本身）。"
          }
        }
      }
    }
  },
  "version": "1.0"
}
