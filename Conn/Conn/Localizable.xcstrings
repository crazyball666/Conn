{
  "sourceLanguage" : "zh-Hans",
  "strings" : {
    "%@ · tmux" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "%@ · tmux" } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "%@ · tmux" } }, "ko" : { "stringUnit" : { "state" : "translated", "value" : "%@ · tmux" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "%@ · tmux" } } } },
    "%d×%d · %@" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "%d×%d · %@" } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "%d×%d · %@" } }, "ko" : { "stringUnit" : { "state" : "translated", "value" : "%d×%d · %@" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "%d×%d · %@" } } } },
    "Control Mode 支持 %@，但本次连接未成功启用。" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Control Mode supports %@, but it could not be enabled for this connection." } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "Control Mode は %@ に対応していますが、今回の接続では有効にできませんでした。" } }, "ko" : { "stringUnit" : { "state" : "translated", "value" : "Control Mode에서 %@을(를) 지원하지만 이번 연결에서는 활성화하지 못했습니다." } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "Control Mode 支援 %@，但此次連線未能成功啟用。" } } } },
    "Pane %d" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Pane %d" } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "ペイン %d" } }, "ko" : { "stringUnit" : { "state" : "translated", "value" : "Pane %d" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "Pane %d" } } } },
    "Pane 标题、命令或路径来自最近快照；订阅首次更新后会切换为实时状态。" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Pane titles, commands, and paths are from the latest snapshot. Live data will replace them after the first subscription update." } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "ペインのタイトル、コマンド、パスは最新のスナップショットです。最初のサブスクリプション更新後にリアルタイムデータへ切り替わります。" } }, "ko" : { "stringUnit" : { "state" : "translated", "value" : "Pane 제목, 명령 및 경로는 최근 스냅샷의 값입니다. 첫 구독 업데이트 후 실시간 데이터로 전환됩니다." } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "Pane 標題、命令或路徑來自最新快照；首次訂閱更新後將切換為即時狀態。" } } } },
    "Session 名称（可选）" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Session Name (Optional)" } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "セッション名（任意）" } }, "ko" : { "stringUnit" : { "state" : "translated", "value" : "Session 이름(선택 사항)" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "Session 名稱（選填）" } } } },
    "Session：%@。" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Session: %@." } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "セッション：%@。" } }, "ko" : { "stringUnit" : { "state" : "translated", "value" : "Session: %@." } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "Session：%@。" } } } },
    "Window：%@。" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Window: %@." } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "ウィンドウ：%@。" } }, "ko" : { "stringUnit" : { "state" : "translated", "value" : "Window: %@." } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "Window：%@。" } } } },
    "Zoom Pane" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Zoom Pane" } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "ペインをズーム" } }, "ko" : { "stringUnit" : { "state" : "translated", "value" : "Pane 확대" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "放大 Pane" } } } },
    "tmux 不可用" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "tmux Unavailable" } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "tmux を利用できません" } }, "ko" : { "stringUnit" : { "state" : "translated", "value" : "tmux 사용 불가" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "tmux 無法使用" } } } },
    "tmux 管理失败" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "tmux Management Failed" } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "tmux の管理に失敗しました" } }, "ko" : { "stringUnit" : { "state" : "translated", "value" : "tmux 관리 실패" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "tmux 管理失敗" } } } },
    "上下分屏" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Split Vertically" } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "上下に分割" } }, "ko" : { "stringUnit" : { "state" : "translated", "value" : "상하 분할" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "上下分割" } } } },
    "修改持久终端别名会同步重命名远程会话；留空将恢复当前会话名称。" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Changing the persistent terminal alias also renames the remote session. Leave blank to restore the current session name." } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "永続ターミナルの別名を変更すると、リモートセッション名も変更されます。空欄にすると現在のセッション名に戻ります。" } }, "ko" : { "stringUnit" : { "state" : "translated", "value" : "지속 터미널 별칭을 변경하면 원격 Session 이름도 함께 변경됩니다. 비워 두면 현재 Session 이름으로 복원됩니다." } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "修改持久終端別名時，遠端 Session 也會同步重新命名；留空則恢復目前的 Session 名稱。" } } } },
    "关闭 Pane" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Close Pane" } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "ペインを閉じる" } }, "ko" : { "stringUnit" : { "state" : "translated", "value" : "Pane 닫기" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "關閉 Pane" } } } },
    "关闭 Window" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Close Window" } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "ウィンドウを閉じる" } }, "ko" : { "stringUnit" : { "state" : "translated", "value" : "Window 닫기" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "關閉 Window" } } } },
    "其他连接：%@。" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Other connections: %@." } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "その他の接続：%@。" } }, "ko" : { "stringUnit" : { "state" : "translated", "value" : "기타 연결: %@." } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "其他連線：%@。" } } } },
    "兼容性与隔离状态" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Compatibility and Isolation" } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "互換性と分離状態" } }, "ko" : { "stringUnit" : { "state" : "translated", "value" : "호환성 및 격리 상태" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "相容性與隔離狀態" } } } },
    "切换" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Switch" } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "切り替え" } }, "ko" : { "stringUnit" : { "state" : "translated", "value" : "전환" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "切換" } } } },
    "切换到 Pane" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Switch to Pane" } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "ペインに切り替え" } }, "ko" : { "stringUnit" : { "state" : "translated", "value" : "Pane으로 전환" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "切換至 Pane" } } } },
    "创建 Session" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Create Session" } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "セッションを作成" } }, "ko" : { "stringUnit" : { "state" : "translated", "value" : "Session 생성" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "建立 Session" } } } },
    "创建并连接" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Create and Connect" } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "作成して接続" } }, "ko" : { "stringUnit" : { "state" : "translated", "value" : "생성 및 연결" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "建立並連線" } } } },
    "刷新 Session 列表" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Refresh Session List" } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "セッション一覧を更新" } }, "ko" : { "stringUnit" : { "state" : "translated", "value" : "Session 목록 새로 고침" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "重新整理 Session 列表" } } } },
    "取消 Zoom" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Exit Zoom" } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "ズームを解除" } }, "ko" : { "stringUnit" : { "state" : "translated", "value" : "확대 해제" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "取消放大" } } } },
    "可返回终端创建流程并新建 Session。" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Return to terminal creation to create a new Session." } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "ターミナル作成画面に戻って新しいセッションを作成できます。" } }, "ko" : { "stringUnit" : { "state" : "translated", "value" : "터미널 생성 화면으로 돌아가 새 Session을 생성할 수 있습니다." } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "可返回終端建立流程並新增 Session。" } } } },
    "同一 Session 关联多个 Conn 终端，请选择需要操作的终端。" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Multiple Conn terminals are linked to this Session. Select the terminal to control." } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "同じセッションに複数の Conn ターミナルが関連付けられています。操作するターミナルを選択してください。" } }, "ko" : { "stringUnit" : { "state" : "translated", "value" : "동일한 Session에 여러 Conn 터미널이 연결되어 있습니다. 제어할 터미널을 선택하세요." } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "同一 Session 已連結多個 Conn 終端，請選擇要操作的終端。" } } } },
    "名称不能为空或包含控制字符" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "The name cannot be empty or contain control characters." } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "名前を空にしたり、制御文字を含めたりすることはできません。" } }, "ko" : { "stringUnit" : { "state" : "translated", "value" : "이름은 비워 둘 수 없으며 제어 문자를 포함할 수 없습니다." } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "名稱不可為空白或包含控制字元。" } } } },
    "启动独立远程 Shell" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Start a Standalone Remote Shell" } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "独立したリモート Shell を起動" } }, "ko" : { "stringUnit" : { "state" : "translated", "value" : "독립 원격 Shell 시작" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "啟動獨立遠端 Shell" } } } },
    "将影响 %d 个 Session、%d 个 Window、%d 个 Pane，可能影响 %d 个其他连接。" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "This will affect %d Sessions, %d Windows, and %d Panes, and may affect %d other connections." } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "%d 個のセッション、%d 個のウィンドウ、%d 個のペインに影響し、ほかの %d 件の接続にも影響する可能性があります。" } }, "ko" : { "stringUnit" : { "state" : "translated", "value" : "Session %d개, Window %d개, Pane %d개에 영향을 주며 다른 연결 %d개에도 영향을 줄 수 있습니다." } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "這將影響 %d 個 Session、%d 個 Window、%d 個 Pane，並可能影響 %d 個其他連線。" } } } },
    "左右分屏" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Split Horizontally" } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "左右に分割" } }, "ko" : { "stringUnit" : { "state" : "translated", "value" : "좌우 분할" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "左右分割" } } } },
    "已断开" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Disconnected" } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "切断済み" } }, "ko" : { "stringUnit" : { "state" : "translated", "value" : "연결 끊김" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "已中斷連線" } } } },
    "已连接" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Connected" } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "接続済み" } }, "ko" : { "stringUnit" : { "state" : "translated", "value" : "연결됨" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "已連線" } } } },
    "当前 tmux 不支持 active-pane，切换 Pane 可能改变其他客户端看到的活动 Pane。" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "This tmux version does not support active-pane isolation. Switching Panes may change the active Pane shown in other clients." } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "現在の tmux は active-pane に対応していません。ペインを切り替えると、ほかのクライアントのアクティブペインが変わる場合があります。" } }, "ko" : { "stringUnit" : { "state" : "translated", "value" : "현재 tmux는 active-pane을 지원하지 않습니다. Pane을 전환하면 다른 클라이언트에 표시되는 활성 Pane이 변경될 수 있습니다." } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "目前的 tmux 不支援 active-pane；切換 Pane 可能會變更其他用戶端看到的作用中 Pane。" } } } },
    "当前 tmux 不支持 ignore-size，多客户端同时连接时窗口尺寸可能互相影响。" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "This tmux version does not support ignore-size. Window sizes may interfere with each other when multiple clients are connected." } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "現在の tmux は ignore-size に対応していません。複数のクライアントが同時に接続すると、ウィンドウサイズが互いに影響する場合があります。" } }, "ko" : { "stringUnit" : { "state" : "translated", "value" : "현재 tmux는 ignore-size를 지원하지 않습니다. 여러 클라이언트가 동시에 연결되면 Window 크기가 서로 영향을 줄 수 있습니다." } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "目前的 tmux 不支援 ignore-size；多個用戶端同時連線時，Window 尺寸可能互相影響。" } } } },
    "当前 tmux 不支持格式订阅，Pane 元数据使用按需快照，可能不是实时值。" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "This tmux version does not support format subscriptions. Pane metadata uses on-demand snapshots and may not be current." } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "現在の tmux はフォーマットサブスクリプションに対応していません。ペインのメタデータはオンデマンドのスナップショットで、最新ではない場合があります。" } }, "ko" : { "stringUnit" : { "state" : "translated", "value" : "현재 tmux는 형식 구독을 지원하지 않습니다. Pane 메타데이터는 요청 시 스냅샷을 사용하므로 최신 값이 아닐 수 있습니다." } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "目前的 tmux 不支援格式訂閱；Pane 中繼資料使用隨選快照，可能不是即時值。" } } } },
    "当前版本未配置可用的持久终端 Provider" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "No persistent terminal Provider is configured in this version." } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "このバージョンには利用可能な永続ターミナル Provider が設定されていません。" } }, "ko" : { "stringUnit" : { "state" : "translated", "value" : "현재 버전에 사용 가능한 지속 터미널 Provider가 구성되지 않았습니다." } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "目前版本未設定可用的持久終端 Provider。" } } } },
    "持久终端：%@" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Persistent Terminal: %@" } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "永続ターミナル：%@" } }, "ko" : { "stringUnit" : { "state" : "translated", "value" : "지속 터미널: %@" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "持久終端：%@" } } } },
    "新建 Window" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "New Window" } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "新規ウィンドウ" } }, "ko" : { "stringUnit" : { "state" : "translated", "value" : "새 Window" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "新增 Window" } } } },
    "暂无 tmux Session" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "No tmux Sessions" } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "tmux セッションなし" } }, "ko" : { "stringUnit" : { "state" : "translated", "value" : "tmux Session 없음" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "暫無 tmux Session" } } } },
    "暂无可用 Session" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "No Available Sessions" } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "利用可能なセッションなし" } }, "ko" : { "stringUnit" : { "state" : "translated", "value" : "사용 가능한 Session 없음" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "暫無可用 Session" } } } },
    "暂无可用主机" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "No Available Hosts" } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "利用可能なホストなし" } }, "ko" : { "stringUnit" : { "state" : "translated", "value" : "사용 가능한 호스트 없음" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "暫無可用主機" } } } },
    "暂无终端" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "No Terminals" } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "ターミナルなし" } }, "ko" : { "stringUnit" : { "state" : "translated", "value" : "터미널 없음" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "暫無終端" } } } },
    "未知错误" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Unknown Error" } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "不明なエラー" } }, "ko" : { "stringUnit" : { "state" : "translated", "value" : "알 수 없는 오류" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "未知錯誤" } } } },
    "检测到多个尺寸参与者，但部分 Conn 终端尚未隔离窗口尺寸，系统会自动重试。" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Multiple size participants were detected, but window-size isolation is not yet active for some Conn terminals. The system will retry automatically." } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "複数のサイズ参加者が検出されましたが、一部の Conn ターミナルではウィンドウサイズがまだ分離されていません。システムが自動的に再試行します。" } }, "ko" : { "stringUnit" : { "state" : "translated", "value" : "여러 크기 참여자가 감지되었지만 일부 Conn 터미널의 Window 크기 격리가 아직 활성화되지 않았습니다. 시스템에서 자동으로 다시 시도합니다." } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "偵測到多個尺寸參與者，但部分 Conn 終端尚未隔離 Window 尺寸；系統將自動重試。" } } } },
    "正在创建终端…" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Creating terminal…" } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "ターミナルを作成しています…" } }, "ko" : { "stringUnit" : { "state" : "translated", "value" : "터미널 생성 중…" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "正在建立終端…" } } } },
    "正在加载 Session 列表…" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Loading Sessions…" } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "セッション一覧を読み込んでいます…" } }, "ko" : { "stringUnit" : { "state" : "translated", "value" : "Session 목록 불러오는 중…" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "正在載入 Session 列表…" } } } },
    "正在加载 tmux 拓扑…" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Loading tmux topology…" } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "tmux トポロジーを読み込んでいます…" } }, "ko" : { "stringUnit" : { "state" : "translated", "value" : "tmux 토폴로지 불러오는 중…" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "正在載入 tmux 拓撲…" } } } },
    "正在检测 tmux…" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Detecting tmux…" } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "tmux を検出しています…" } }, "ko" : { "stringUnit" : { "state" : "translated", "value" : "tmux 감지 중…" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "正在偵測 tmux…" } } } },
    "正在重连" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Reconnecting" } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "再接続中" } }, "ko" : { "stringUnit" : { "state" : "translated", "value" : "다시 연결 중" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "正在重新連線" } } } },
    "留空将恢复自动生成的名称。" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Leave blank to restore the automatically generated name." } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "空欄にすると自動生成された名前に戻ります。" } }, "ko" : { "stringUnit" : { "state" : "translated", "value" : "비워 두면 자동 생성된 이름으로 복원됩니다." } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "留空將恢復自動產生的名稱。" } } } },
    "确认共享 tmux 操作" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Confirm Shared tmux Operation" } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "共有 tmux 操作を確認" } }, "ko" : { "stringUnit" : { "state" : "translated", "value" : "공유 tmux 작업 확인" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "確認共用 tmux 操作" } } } },
    "确认关闭 Pane" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Confirm Pane Closure" } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "ペインを閉じる操作を確認" } }, "ko" : { "stringUnit" : { "state" : "translated", "value" : "Pane 닫기 확인" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "確認關閉 Pane" } } } },
    "确认关闭 Window" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Confirm Window Closure" } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "ウィンドウを閉じる操作を確認" } }, "ko" : { "stringUnit" : { "state" : "translated", "value" : "Window 닫기 확인" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "確認關閉 Window" } } } },
    "确认执行" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Confirm Operation" } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "操作を確認" } }, "ko" : { "stringUnit" : { "state" : "translated", "value" : "작업 확인" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "確認執行" } } } },
    "确认终止 Session" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Confirm Session Termination" } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "セッションの終了を確認" } }, "ko" : { "stringUnit" : { "state" : "translated", "value" : "Session 종료 확인" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "確認終止 Session" } } } },
    "确认远程操作" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Confirm Remote Operation" } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "リモート操作を確認" } }, "ko" : { "stringUnit" : { "state" : "translated", "value" : "원격 작업 확인" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "確認遠端操作" } } } },
    "终止 Session" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Terminate Session" } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "セッションを終了" } }, "ko" : { "stringUnit" : { "state" : "translated", "value" : "Session 종료" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "終止 Session" } } } },
    "终端会话不存在" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Terminal Session Not Found" } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "ターミナルセッションが見つかりません" } }, "ko" : { "stringUnit" : { "state" : "translated", "value" : "터미널 Session을 찾을 수 없음" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "找不到終端 Session" } } } },
    "终端类型" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Terminal Type" } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "ターミナルの種類" } }, "ko" : { "stringUnit" : { "state" : "translated", "value" : "터미널 유형" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "終端類型" } } } },
    "继续执行" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Continue" } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "続行" } }, "ko" : { "stringUnit" : { "state" : "translated", "value" : "계속" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "繼續執行" } } } },
    "脚本仅填入终端，不会自动执行。" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "The script is inserted into the terminal but is not run automatically." } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "スクリプトはターミナルに入力されますが、自動実行はされません。" } }, "ko" : { "stringUnit" : { "state" : "translated", "value" : "스크립트가 터미널에 입력되지만 자동으로 실행되지는 않습니다." } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "指令碼只會填入終端，不會自動執行。" } } } },
    "该操作会修改 tmux 共享状态，影响 %d 个 Session。" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "This operation changes shared tmux state and affects %d Sessions." } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "この操作は tmux の共有状態を変更し、%d 個のセッションに影響します。" } }, "ko" : { "stringUnit" : { "state" : "translated", "value" : "이 작업은 공유 tmux 상태를 변경하며 Session %d개에 영향을 줍니다." } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "此操作會修改 tmux 共用狀態，並影響 %d 個 Session。" } } } },
    "该终端会话可能已关闭。" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "This terminal session may have been closed." } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "このターミナルセッションはすでに閉じられている可能性があります。" } }, "ko" : { "stringUnit" : { "state" : "translated", "value" : "이 터미널 Session이 이미 닫혔을 수 있습니다." } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "此終端 Session 可能已關閉。" } } } },
    "请先在“脚本”页面添加常用脚本" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Add frequently used scripts on the Scripts page first." } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "先に「スクリプト」ページでよく使うスクリプトを追加してください。" } }, "ko" : { "stringUnit" : { "state" : "translated", "value" : "먼저 ‘스크립트’ 페이지에서 자주 사용하는 스크립트를 추가하세요." } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "請先在「指令碼」頁面新增常用指令碼" } } } },
    "路径未知" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Unknown Path" } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "不明なパス" } }, "ko" : { "stringUnit" : { "state" : "translated", "value" : "알 수 없는 경로" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "未知路徑" } } } },
    "返回不会关闭会话。仅“退出终端”或在会话列表中关闭时，才会终止该 PTY。" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Going back does not close the session. The PTY is terminated only when you select “Exit Terminal” or close it from the session list." } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "戻るだけではセッションは閉じません。PTY は「ターミナルを終了」を選ぶか、セッション一覧から閉じた場合にのみ終了します。" } }, "ko" : { "stringUnit" : { "state" : "translated", "value" : "뒤로 이동해도 Session은 닫히지 않습니다. ‘터미널 종료’를 선택하거나 Session 목록에서 닫을 때만 PTY가 종료됩니다." } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "返回不會關閉 Session。只有選擇「退出終端」或從 Session 列表中關閉時，才會終止該 PTY。" } } } },
    "连接或创建可恢复的远程 Session" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Connect to or create a resumable remote Session" } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "再開可能なリモートセッションに接続または新規作成" } }, "ko" : { "stringUnit" : { "state" : "translated", "value" : "재개 가능한 원격 Session에 연결하거나 새로 생성" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "連線或建立可恢復的遠端 Session" } } } },
    "连接现有 Session" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Connect to Existing Session" } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "既存のセッションに接続" } }, "ko" : { "stringUnit" : { "state" : "translated", "value" : "기존 Session에 연결" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "連線至現有 Session" } } } },
    "选择持久终端" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Select Persistent Terminal" } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "永続ターミナルを選択" } }, "ko" : { "stringUnit" : { "state" : "translated", "value" : "지속 터미널 선택" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "選擇持久終端" } } } },
    "选择要控制的 Conn 终端" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Select a Conn Terminal to Control" } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "操作する Conn ターミナルを選択" } }, "ko" : { "stringUnit" : { "state" : "translated", "value" : "제어할 Conn 터미널 선택" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "選擇要控制的 Conn 終端" } } } },
    "部分 Conn 终端尚未启用 Pane 焦点隔离，系统会在下一次拓扑同步时重试。" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Pane focus isolation is not yet active for some Conn terminals. The system will retry during the next topology sync." } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "一部の Conn ターミナルではペインフォーカスの分離がまだ有効ではありません。次回のトポロジー同期時に再試行します。" } }, "ko" : { "stringUnit" : { "state" : "translated", "value" : "일부 Conn 터미널에서 Pane 포커스 격리가 아직 활성화되지 않았습니다. 다음 토폴로지 동기화 시 다시 시도합니다." } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "部分 Conn 終端尚未啟用 Pane 焦點隔離；系統將在下次拓撲同步時重試。" } } } },
    "部分 Pane 标题、命令或路径不可用或已过期，请刷新拓扑后再使用这些信息。" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Some Pane titles, commands, or paths are unavailable or stale. Refresh the topology before using this information." } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "一部のペインのタイトル、コマンド、パスを利用できないか、情報が古くなっています。トポロジーを更新してから使用してください。" } }, "ko" : { "stringUnit" : { "state" : "translated", "value" : "일부 Pane 제목, 명령 또는 경로를 사용할 수 없거나 정보가 오래되었습니다. 토폴로지를 새로 고친 후 사용하세요." } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "部分 Pane 標題、命令或路徑無法使用或已過期，請重新整理拓撲後再使用這些資訊。" } } } },
    "部分 tmux 格式订阅未启用，Pane 元数据可能降级为快照。" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Some tmux format subscriptions are not active. Pane metadata may fall back to snapshots." } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "一部の tmux フォーマットサブスクリプションが有効ではありません。ペインのメタデータはスナップショットにフォールバックする場合があります。" } }, "ko" : { "stringUnit" : { "state" : "translated", "value" : "일부 tmux 형식 구독이 활성화되지 않았습니다. Pane 메타데이터가 스냅샷으로 대체될 수 있습니다." } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "部分 tmux 格式訂閱未啟用；Pane 中繼資料可能降級為快照。" } } } },
    "当前主机平台仅支持此脚本的部分能力，仍可继续执行。" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "The current host platform supports only some capabilities of this script. You can still continue." } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "現在のホストプラットフォームでは、このスクリプトの一部の機能のみ利用できます。実行は続行できます。" } }, "ko" : { "stringUnit" : { "state" : "translated", "value" : "현재 호스트 플랫폼에서는 이 스크립트의 일부 기능만 지원합니다. 계속 실행할 수 있습니다." } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "目前主機平台僅支援此指令碼的部分功能，仍可繼續執行。" } } } },
    "远程主机缺少执行此脚本所需的命令。" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "The remote host is missing commands required by this script." } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "リモートホストに、このスクリプトの実行に必要なコマンドがありません。" } }, "ko" : { "stringUnit" : { "state" : "translated", "value" : "원격 호스트에 이 스크립트 실행에 필요한 명령이 없습니다." } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "遠端主機缺少執行此指令碼所需的命令。" } } } },
    "远程主机缺少部分可选命令，脚本仍可继续执行。" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "The remote host is missing some optional commands. The script can still run." } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "リモートホストに一部の任意コマンドがありませんが、スクリプトは実行できます。" } }, "ko" : { "stringUnit" : { "state" : "translated", "value" : "원격 호스트에 일부 선택 명령이 없지만 스크립트는 계속 실행할 수 있습니다." } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "遠端主機缺少部分選用命令，指令碼仍可繼續執行。" } } } },
    "部分脚本能力依赖的服务未运行，仍可继续执行。" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Some services used by optional script capabilities are not running. You can still continue." } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "スクリプトの一部機能が使用するサービスは実行されていませんが、実行は続行できます。" } }, "ko" : { "stringUnit" : { "state" : "translated", "value" : "일부 스크립트 기능에 필요한 서비스가 실행 중이 아니지만 계속 실행할 수 있습니다." } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "部分指令碼功能所需的服務尚未執行，仍可繼續執行。" } } } },
    "部分脚本能力受权限限制，仍可继续执行。" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Some script capabilities are restricted by permissions. You can still continue." } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "スクリプトの一部機能は権限により制限されていますが、実行は続行できます。" } }, "ko" : { "stringUnit" : { "state" : "translated", "value" : "일부 스크립트 기능이 권한에 의해 제한되지만 계속 실행할 수 있습니다." } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "部分指令碼功能受權限限制，仍可繼續執行。" } } } },
    "部分远程能力数据不可用，脚本仍可继续执行。" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Some remote capability data is unavailable. The script can still run." } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "一部のリモート機能データを取得できませんが、スクリプトは実行できます。" } }, "ko" : { "stringUnit" : { "state" : "translated", "value" : "일부 원격 기능 데이터를 사용할 수 없지만 스크립트는 계속 실행할 수 있습니다." } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "部分遠端功能資料無法使用，指令碼仍可繼續執行。" } } } },
    "部分脚本要求无法确认，仍可继续执行。" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Some script requirements could not be verified. You can still continue." } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "スクリプトの一部要件を確認できませんが、実行は続行できます。" } }, "ko" : { "stringUnit" : { "state" : "translated", "value" : "일부 스크립트 요구 사항을 확인할 수 없지만 계속 실행할 수 있습니다." } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "部分指令碼需求無法確認，仍可繼續執行。" } } } },
    "部分脚本能力状态未知，仍可继续执行。" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "The status of some script capabilities is unknown. You can still continue." } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "スクリプトの一部機能の状態は不明ですが、実行は続行できます。" } }, "ko" : { "stringUnit" : { "state" : "translated", "value" : "일부 스크립트 기능 상태를 알 수 없지만 계속 실행할 수 있습니다." } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "部分指令碼功能狀態未知，仍可繼續執行。" } } } },
    "暂无 Compose 项目" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "No Compose Projects" } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "Compose プロジェクトなし" } }, "ko" : { "stringUnit" : { "state" : "translated", "value" : "Compose 프로젝트 없음" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "暫無 Compose 專案" } } } },
    "未找到匹配的 Compose 项目" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "No Matching Compose Projects" } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "一致する Compose プロジェクトがありません" } }, "ko" : { "stringUnit" : { "state" : "translated", "value" : "일치하는 Compose 프로젝트 없음" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "找不到符合的 Compose 專案" } } } },
    "该项目暂无服务" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "No Services in This Project" } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "このプロジェクトにサービスはありません" } }, "ko" : { "stringUnit" : { "state" : "translated", "value" : "이 프로젝트에 서비스 없음" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "此專案暫無服務" } } } },
    "仅从当前会话的项目列表中移除，不会停止或删除远程主机上的 Docker 资源。" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Removes the project only from this session's list. Docker resources on the remote host will not be stopped or deleted." } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "現在のセッションのプロジェクト一覧からのみ削除します。リモートホスト上の Docker リソースは停止または削除されません。" } }, "ko" : { "stringUnit" : { "state" : "translated", "value" : "현재 세션의 프로젝트 목록에서만 제거합니다. 원격 호스트의 Docker 리소스는 중지되거나 삭제되지 않습니다." } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "僅從目前工作階段的專案列表中移除，不會停止或刪除遠端主機上的 Docker 資源。" } } } },
    "该主机暂无容器" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "No Containers on This Host" } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "このホストにコンテナはありません" } }, "ko" : { "stringUnit" : { "state" : "translated", "value" : "이 호스트에 컨테이너 없음" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "此主機暫無容器" } } } },
    "未找到匹配的容器" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "No Matching Containers" } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "一致するコンテナがありません" } }, "ko" : { "stringUnit" : { "state" : "translated", "value" : "일치하는 컨테이너 없음" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "找不到符合的容器" } } } },
    "暂无镜像" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "No Images" } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "イメージなし" } }, "ko" : { "stringUnit" : { "state" : "translated", "value" : "이미지 없음" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "暫無映像檔" } } } },
    "未找到匹配的镜像" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "No Matching Images" } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "一致するイメージがありません" } }, "ko" : { "stringUnit" : { "state" : "translated", "value" : "일치하는 이미지 없음" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "找不到符合的映像檔" } } } },
    "暂无卷" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "No Volumes" } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "ボリュームなし" } }, "ko" : { "stringUnit" : { "state" : "translated", "value" : "볼륨 없음" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "暫無磁碟區" } } } },
    "未找到匹配的卷" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "No Matching Volumes" } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "一致するボリュームがありません" } }, "ko" : { "stringUnit" : { "state" : "translated", "value" : "일치하는 볼륨 없음" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "找不到符合的磁碟區" } } } },
    "暂无网络" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "No Networks" } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "ネットワークなし" } }, "ko" : { "stringUnit" : { "state" : "translated", "value" : "네트워크 없음" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "暫無網路" } } } },
    "未找到匹配的网络" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "No Matching Networks" } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "一致するネットワークがありません" } }, "ko" : { "stringUnit" : { "state" : "translated", "value" : "일치하는 네트워크 없음" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "找不到符合的網路" } } } },
    "暂无容器使用此镜像" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "No Containers Use This Image" } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "このイメージを使用しているコンテナはありません" } }, "ko" : { "stringUnit" : { "state" : "translated", "value" : "이 이미지를 사용하는 컨테이너 없음" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "暫無容器使用此映像檔" } } } },
    "暂无容器引用此卷" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "No Containers Reference This Volume" } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "このボリュームを参照しているコンテナはありません" } }, "ko" : { "stringUnit" : { "state" : "translated", "value" : "이 볼륨을 참조하는 컨테이너 없음" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "暫無容器參照此磁碟區" } } } },
    "暂无容器接入此网络" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "No Containers Use This Network" } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "このネットワークに接続しているコンテナはありません" } }, "ko" : { "stringUnit" : { "state" : "translated", "value" : "이 네트워크에 연결된 컨테이너 없음" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "暫無容器連接此網路" } } } },
    "Docker 守护进程未运行。\n请在远程主机上启动：\nsudo systemctl start docker" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "The Docker daemon is not running.\nStart it on the remote host:\nsudo systemctl start docker" } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "Docker デーモンが実行されていません。\nリモートホストで起動してください：\nsudo systemctl start docker" } }, "ko" : { "stringUnit" : { "state" : "translated", "value" : "Docker 데몬이 실행 중이 아닙니다.\n원격 호스트에서 시작하세요:\nsudo systemctl start docker" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "Docker 守護程式尚未執行。\n請在遠端主機上啟動：\nsudo systemctl start docker" } } } },
    "每行填写一个 Docker 参数，格式为 --flag=value。空行及以 # 开头的行将被忽略；%@、%@、%@ 和 %@ 也可在此配置。" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Enter one Docker argument per line using --flag=value. Blank lines and lines beginning with # are ignored. %@, %@, %@, and %@ can also be configured here." } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "Docker 引数を 1 行に 1 つ、--flag=value の形式で入力します。空行と # で始まる行は無視されます。%@、%@、%@、%@ もここで設定できます。" } }, "ko" : { "stringUnit" : { "state" : "translated", "value" : "Docker 인수를 줄마다 하나씩 --flag=value 형식으로 입력하세요. 빈 줄과 #으로 시작하는 줄은 무시됩니다. %@, %@, %@ 및 %@도 여기에서 설정할 수 있습니다." } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "每行輸入一個 Docker 參數，格式為 --flag=value。空白行與以 # 開頭的行將被忽略；%@、%@、%@ 和 %@ 也可在此設定。" } } } },
    "等待远程输出…" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Waiting for remote output…" } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "リモート出力を待っています…" } }, "ko" : { "stringUnit" : { "state" : "translated", "value" : "원격 출력 대기 중…" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "正在等待遠端輸出…" } } } },
    "配置文件必须使用远程主机上的绝对路径。" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "The configuration file must use an absolute path on the remote host." } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "設定ファイルには、リモートホスト上の絶対パスを指定してください。" } }, "ko" : { "stringUnit" : { "state" : "translated", "value" : "구성 파일은 원격 호스트의 절대 경로를 사용해야 합니다." } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "設定檔必須使用遠端主機上的絕對路徑。" } } } },
    "权限不足，无法读取日志" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Insufficient permission to read logs." } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "権限がないためログを読み込めません。" } }, "ko" : { "stringUnit" : { "state" : "translated", "value" : "권한이 부족하여 로그를 읽을 수 없습니다." } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "權限不足，無法讀取日誌。" } } } },
    "当前主机平台暂不支持日志采集" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Log collection is not supported on the current host platform." } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "現在のホストプラットフォームではログ収集に対応していません。" } }, "ko" : { "stringUnit" : { "state" : "translated", "value" : "현재 호스트 플랫폼에서는 로그 수집을 지원하지 않습니다." } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "目前主機平台暫不支援日誌收集。" } } } },
    "日志采集暂不可用" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Log Collection Unavailable" } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "ログ収集を利用できません" } }, "ko" : { "stringUnit" : { "state" : "translated", "value" : "로그 수집 사용 불가" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "日誌收集暫時無法使用" } } } },
    "部分日志来源不可用" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Some Log Sources Unavailable" } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "一部のログソースを利用できません" } }, "ko" : { "stringUnit" : { "state" : "translated", "value" : "일부 로그 소스 사용 불가" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "部分日誌來源無法使用" } } } },
    "未发现常用日志源。\n可在终端中查看自定义路径。" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "No common log sources were found.\nUse the terminal to inspect a custom path." } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "一般的なログソースが見つかりません。\nカスタムパスはターミナルで確認できます。" } }, "ko" : { "stringUnit" : { "state" : "translated", "value" : "일반 로그 소스를 찾지 못했습니다.\n터미널에서 사용자 지정 경로를 확인할 수 있습니다." } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "找不到常用日誌來源。\n可在終端中檢視自訂路徑。" } } } },
    "权限不足，无法读取完整进程信息" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Insufficient permission to read complete process information." } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "権限がないため完全なプロセス情報を読み込めません。" } }, "ko" : { "stringUnit" : { "state" : "translated", "value" : "권한이 부족하여 전체 프로세스 정보를 읽을 수 없습니다." } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "權限不足，無法讀取完整程序資訊。" } } } },
    "当前主机平台暂不支持进程采集" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Process collection is not supported on the current host platform." } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "現在のホストプラットフォームではプロセス収集に対応していません。" } }, "ko" : { "stringUnit" : { "state" : "translated", "value" : "현재 호스트 플랫폼에서는 프로세스 수집을 지원하지 않습니다." } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "目前主機平台暫不支援程序收集。" } } } },
    "进程采集暂不可用" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Process Collection Unavailable" } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "プロセス収集を利用できません" } }, "ko" : { "stringUnit" : { "state" : "translated", "value" : "프로세스 수집 사용 불가" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "程序收集暫時無法使用" } } } },
    "部分进程详情不可用" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Some Process Details Unavailable" } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "一部のプロセス情報を利用できません" } }, "ko" : { "stringUnit" : { "state" : "translated", "value" : "일부 프로세스 세부 정보 사용 불가" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "部分程序詳細資料無法使用" } } } },
    "“%@”将从本地列表中永久删除，但不会影响远程主机。" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "“%@” will be permanently removed from the local list. The remote host will not be affected." } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "「%@」をローカルリストから完全に削除します。リモートホストには影響しません。" } }, "ko" : { "stringUnit" : { "state" : "translated", "value" : "“%@”을(를) 로컬 목록에서 영구적으로 삭제합니다. 원격 호스트에는 영향을 주지 않습니다." } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "「%@」將從本機列表中永久刪除，但不會影響遠端主機。" } } } },
    "%d 个本地终端" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "%d local terminals" } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "ローカルターミナル %d 件" } }, "ko" : { "stringUnit" : { "state" : "translated", "value" : "로컬 터미널 %d개" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "%d 個本機終端" } } } },
    "主机不存在或已被删除" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "The host does not exist or has been deleted." } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "ホストが存在しないか、削除されています。" } }, "ko" : { "stringUnit" : { "state" : "translated", "value" : "호스트가 없거나 삭제되었습니다." } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "主機不存在或已被刪除。" } } } },
    "删除分组不会删除其中的主机。" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Deleting the group will not delete its hosts." } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "グループを削除しても、その中のホストは削除されません。" } }, "ko" : { "stringUnit" : { "state" : "translated", "value" : "그룹을 삭제해도 그룹의 호스트는 삭제되지 않습니다." } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "刪除群組不會刪除其中的主機。" } } } },
    "新增主机" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Add Host" } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "ホストを追加" } }, "ko" : { "stringUnit" : { "state" : "translated", "value" : "호스트 추가" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "新增主機" } } } },
    "暂无主机" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "No Hosts" } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "ホストなし" } }, "ko" : { "stringUnit" : { "state" : "translated", "value" : "호스트 없음" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "暫無主機" } } } },
    "添加第一台主机以开始监控和管理" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Add your first host to start monitoring and management." } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "最初のホストを追加して、監視と管理を開始します。" } }, "ko" : { "stringUnit" : { "state" : "translated", "value" : "첫 번째 호스트를 추가하여 모니터링과 관리를 시작하세요." } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "新增第一台主機以開始監控與管理" } } } },
    "连接失败，请下拉刷新重试" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Connection failed. Pull down to refresh and try again." } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "接続に失敗しました。下に引いて更新し、再試行してください。" } }, "ko" : { "stringUnit" : { "state" : "translated", "value" : "연결하지 못했습니다. 아래로 당겨 새로 고친 후 다시 시도하세요." } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "連線失敗，請下拉重新整理後再試。" } } } },
    "连接成功" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Connected" } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "接続しました" } }, "ko" : { "stringUnit" : { "state" : "translated", "value" : "연결됨" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "連線成功" } } } },
    "无法读取本地配置，请重试。本地数据不会上传。" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Unable to read the local configuration. Try again. Local data will not be uploaded." } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "ローカル設定を読み込めません。再試行してください。ローカルデータがアップロードされることはありません。" } }, "ko" : { "stringUnit" : { "state" : "translated", "value" : "로컬 구성을 읽을 수 없습니다. 다시 시도하세요. 로컬 데이터는 업로드되지 않습니다." } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "無法讀取本機設定，請再試。本機資料不會上傳。" } } } },
    "密钥管理" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Key Management" } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "鍵管理" } }, "ko" : { "stringUnit" : { "state" : "translated", "value" : "키 관리" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "金鑰管理" } } } },
    "暂无密钥" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "No Keys" } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "鍵なし" } }, "ko" : { "stringUnit" : { "state" : "translated", "value" : "키 없음" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "暫無金鑰" } } } },
    "暂无密钥，请先在“密钥管理”中生成或导入密钥。" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "No keys are available. Generate or import one in Key Management first." } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "利用可能な鍵がありません。先に「鍵管理」で生成またはインポートしてください。" } }, "ko" : { "stringUnit" : { "state" : "translated", "value" : "사용 가능한 키가 없습니다. 먼저 ‘키 관리’에서 생성하거나 가져오세요." } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "暫無可用金鑰，請先在「金鑰管理」中產生或匯入金鑰。" } } } },
    "生成 Ed25519 密钥并部署到主机，即可使用密钥认证。" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Generate an Ed25519 key and deploy it to a host to use key-based authentication." } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "Ed25519 鍵を生成してホストに配備すると、鍵認証を使用できます。" } }, "ko" : { "stringUnit" : { "state" : "translated", "value" : "Ed25519 키를 생성하여 호스트에 배포하면 키 인증을 사용할 수 있습니다." } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "產生 Ed25519 金鑰並部署至主機，即可使用金鑰驗證。" } } } },
    "留空时将显示主机地址。" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Leave blank to display the host address." } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "空欄の場合はホストアドレスが表示されます。" } }, "ko" : { "stringUnit" : { "state" : "translated", "value" : "비워 두면 호스트 주소가 표시됩니다." } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "留空時將顯示主機位址。" } } } },
    "暂无分组，请使用右上角“+”创建分组。" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "No groups are available. Use “+” in the upper-right corner to create one." } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "グループがありません。右上の「+」から作成してください。" } }, "ko" : { "stringUnit" : { "state" : "translated", "value" : "그룹이 없습니다. 오른쪽 상단의 ‘+’를 눌러 생성하세요." } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "暫無群組，請使用右上角的「+」建立群組。" } } } },
    "暂无执行记录" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "No Run History" } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "実行履歴なし" } }, "ko" : { "stringUnit" : { "state" : "translated", "value" : "실행 기록 없음" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "暫無執行記錄" } } } },
    "容器操作和脚本执行记录将显示在此处" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Container operations and script runs will appear here." } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "コンテナ操作とスクリプト実行の履歴がここに表示されます。" } }, "ko" : { "stringUnit" : { "state" : "translated", "value" : "컨테이너 작업 및 스크립트 실행 기록이 여기에 표시됩니다." } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "容器操作與腳本執行記錄將顯示於此。" } } } },
    "支持单行或多行 Shell 脚本。变量格式为 {{名称}} 或 {{名称:默认值}}，执行前需填写变量值。" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Supports single-line and multi-line Shell scripts. Use {{name}} or {{name:default}} for variables; values are required before execution." } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "1 行または複数行の Shell スクリプトに対応しています。変数は {{名前}} または {{名前:既定値}} の形式で指定し、実行前に値を入力します。" } }, "ko" : { "stringUnit" : { "state" : "translated", "value" : "한 줄 또는 여러 줄 Shell 스크립트를 지원합니다. 변수 형식은 {{이름}} 또는 {{이름:기본값}}이며 실행 전에 값을 입력해야 합니다." } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "支援單行或多行 Shell 指令碼。變數格式為 {{名稱}} 或 {{名稱:預設值}}，執行前須填寫變數值。" } } } },
    "暂无分组，请先在“分组管理”中创建分组。" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "No groups are available. Create one in Group Management first." } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "グループがありません。先に「グループ管理」で作成してください。" } }, "ko" : { "stringUnit" : { "state" : "translated", "value" : "그룹이 없습니다. 먼저 ‘그룹 관리’에서 생성하세요." } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "暫無群組，請先在「群組管理」中建立群組。" } } } },
    "暂无可用主机，请先在“主机”页面添加主机。" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "No hosts are available. Add a host on the Hosts page first." } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "利用可能なホストがありません。先に「ホスト」ページで追加してください。" } }, "ko" : { "stringUnit" : { "state" : "translated", "value" : "사용 가능한 호스트가 없습니다. 먼저 ‘호스트’ 페이지에서 호스트를 추가하세요." } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "暫無可用主機，請先在「主機」頁面新增主機。" } } } },
    "在终端中执行" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Run in Terminal" } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "ターミナルで実行" } }, "ko" : { "stringUnit" : { "state" : "translated", "value" : "터미널에서 실행" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "在終端中執行" } } } },
    "暂无分组" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "No Groups" } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "グループなし" } }, "ko" : { "stringUnit" : { "state" : "translated", "value" : "그룹 없음" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "暫無群組" } } } },
    "使用右上角“+”创建分组" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Use “+” in the upper-right corner to create a group." } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "右上の「+」からグループを作成します。" } }, "ko" : { "stringUnit" : { "state" : "translated", "value" : "오른쪽 상단의 ‘+’를 눌러 그룹을 생성하세요." } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "使用右上角的「+」建立群組" } } } },
    "未找到匹配的分组" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "No Matching Groups" } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "一致するグループがありません" } }, "ko" : { "stringUnit" : { "state" : "translated", "value" : "일치하는 그룹 없음" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "找不到符合的群組" } } } },
    "暂无脚本" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "No Scripts" } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "スクリプトなし" } }, "ko" : { "stringUnit" : { "state" : "translated", "value" : "스크립트 없음" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "暫無指令碼" } } } },
    "未找到匹配的脚本" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "No Matching Scripts" } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "一致するスクリプトがありません" } }, "ko" : { "stringUnit" : { "state" : "translated", "value" : "일치하는 스크립트 없음" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "找不到符合的指令碼" } } } },
    "读取脚本失败，请重试" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Unable to load scripts. Try again." } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "スクリプトを読み込めません。再試行してください。" } }, "ko" : { "stringUnit" : { "state" : "translated", "value" : "스크립트를 불러올 수 없습니다. 다시 시도하세요." } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "無法讀取指令碼，請再試。" } } } },
    "主机连接配置已变化，请重新检查后执行" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "The host connection configuration has changed. Review it before running again." } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "ホストの接続設定が変更されました。確認してから再実行してください。" } }, "ko" : { "stringUnit" : { "state" : "translated", "value" : "호스트 연결 구성이 변경되었습니다. 다시 확인한 후 실행하세요." } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "主機連線設定已變更，請重新檢查後再執行。" } } } },
    "命中风险：%@" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Detected risk: %@" } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "検出されたリスク：%@" } }, "ko" : { "stringUnit" : { "state" : "translated", "value" : "감지된 위험: %@" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "偵測到風險：%@" } } } },
    "将对 %d 台主机执行。请输入 %@ 以确认。" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "This will run on %d hosts. Enter %@ to confirm." } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "%d 台のホストで実行します。確認のため %@ と入力してください。" } }, "ko" : { "stringUnit" : { "state" : "translated", "value" : "호스트 %d대에서 실행됩니다. 확인하려면 %@을(를) 입력하세요." } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "即將在 %d 台主機上執行。請輸入 %@ 以確認。" } } } },
    "确认批量执行" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Confirm Batch Run" } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "一括実行を確認" } }, "ko" : { "stringUnit" : { "state" : "translated", "value" : "일괄 실행 확인" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "確認批次執行" } } } },
    "正在打开终端…" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Opening terminal…" } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "ターミナルを開いています…" } }, "ko" : { "stringUnit" : { "state" : "translated", "value" : "터미널 여는 중…" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "正在開啟終端…" } } } },
    "当前用户缺少执行此脚本所需的权限。" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "The current user does not have the permissions required to run this script." } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "現在のユーザーには、このスクリプトの実行に必要な権限がありません。" } }, "ko" : { "stringUnit" : { "state" : "translated", "value" : "현재 사용자에게 이 스크립트 실행에 필요한 권한이 없습니다." } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "目前使用者缺少執行此指令碼所需的權限。" } } } },
    "执行此脚本所需的服务未运行。" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "A service required by this script is not running." } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "このスクリプトに必要なサービスが実行されていません。" } }, "ko" : { "stringUnit" : { "state" : "translated", "value" : "이 스크립트에 필요한 서비스가 실행되고 있지 않습니다." } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "執行此指令碼所需的服務尚未執行。" } } } },
    "远程主机未提供执行此脚本所需的完整数据。" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "The remote host did not provide all data required by this script." } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "リモートホストから、このスクリプトの実行に必要なデータをすべて取得できませんでした。" } }, "ko" : { "stringUnit" : { "state" : "translated", "value" : "원격 호스트에서 이 스크립트 실행에 필요한 전체 데이터를 제공하지 않았습니다." } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "遠端主機未提供執行此指令碼所需的完整資料。" } } } },
    "无法确认远程主机是否满足脚本要求。" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Unable to determine whether the remote host meets the script requirements." } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "リモートホストがスクリプトの要件を満たすか確認できません。" } }, "ko" : { "stringUnit" : { "state" : "translated", "value" : "원격 호스트가 스크립트 요구 사항을 충족하는지 확인할 수 없습니다." } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "無法確認遠端主機是否符合指令碼需求。" } } } },
