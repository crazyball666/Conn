    "数据仅存本机与你自己的 iCloud · 无账号 · 零上传": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Data stays on this device and your own iCloud · No account · Zero upload"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "データは本端末とあなた自身の iCloud にのみ保存 · アカウント不要 · アップロードなし"
