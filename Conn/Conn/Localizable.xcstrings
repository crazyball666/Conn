    "一行一项 docker flag，可写 --flag=value 形式。空行与 # 开头行忽略；%@、%@、%@和%@也可在这里填写。" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enter one Docker flag per line using --flag=value. Empty lines and lines beginning with # are ignored. You may also enter %1$@, %2$@, %3$@, and %4$@ here."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Docker フラグを 1 行に 1 つ、--flag=value 形式で入力します。空行と # で始まる行は無視されます。%1$@、%2$@、%3$@、%4$@ も入力できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Docker 플래그를 --flag=value 형식으로 한 줄에 하나씩 입력합니다. 빈 줄과 #으로 시작하는 줄은 무시됩니다. %1$@, %2$@, %3$@, %4$@도 입력할 수 있습니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "每行填写一个 Docker flag，格式为 --flag=value。空行和以 # 开头的行会被忽略；也可以填写 %1$@、%2$@、%3$@ 和 %4$@。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "每行輸入一個 Docker flag，格式為 --flag=value。空行與以 # 開頭的行會被忽略；也可以輸入 %1$@、%2$@、%3$@ 和 %4$@。"
          }
        }
      }
    },
