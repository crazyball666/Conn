{
  "version": 1,
  "groups": [
    { "key": "system", "title": "系统", "legacyNames": ["系统", "System", "系統", "システム", "시스템"] },
    { "key": "network", "title": "网络", "legacyNames": ["网络", "Network", "網路", "ネットワーク", "네트워크"] }
  ],
  "commands": [
    {
      "key": "system-overview-linux",
      "title": "系统概览",
      "script": "uname -a; echo; uptime; echo; free -h",
      "pinned": true,
      "groups": ["system"]
    },
    {
      "key": "cpu-top-linux",
      "title": "CPU 占用 Top 10",
      "script": "ps -eo pid,comm,pcpu --sort=-pcpu | head -11",
      "groups": ["system"]
    },
    {
      "key": "memory-top-linux",
      "title": "内存占用 Top 10",
      "script": "ps -eo pid,comm,pmem --sort=-pmem | head -11",
      "groups": ["system"]
    },
    {
      "key": "service-status-linux",
      "title": "服务状态",
      "script": "systemctl status {{unit:nginx}} --no-pager",
      "groups": ["system"]
    },
    {
      "key": "listening-ports-linux",
      "title": "监听端口",
      "script": "ss -tulnp",
      "pinned": true,
      "groups": ["network"]
    },
    {
      "key": "connectivity-test",
      "title": "连通性测试",
      "script": "ping -c 4 {{host:8.8.8.8}}",
      "groups": ["network"]
    }
  ]
}
