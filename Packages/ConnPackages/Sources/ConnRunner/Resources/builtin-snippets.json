{
  "groups": [
    "系统",
    "磁盘",
    "网络",
    "日志",
    "Docker"
  ],
  "commands": [
    {
      "title": "系统概览",
      "script": "uname -a; echo; uptime; echo; free -h",
      "pinned": true,
      "groups": [
        "系统"
      ]
    },
    {
      "title": "CPU 占用 Top 10",
      "script": "ps -eo pid,comm,pcpu --sort=-pcpu | head -11",
      "groups": [
        "系统"
      ]
    },
    {
      "title": "内存占用 Top 10",
      "script": "ps -eo pid,comm,pmem --sort=-pmem | head -11",
      "groups": [
        "系统"
      ]
    },
    {
      "title": "服务状态",
      "script": "systemctl status {{unit:nginx}} --no-pager",
      "groups": [
        "系统"
      ]
    },
    {
      "title": "磁盘使用",
      "script": "df -h",
      "pinned": true,
      "groups": [
        "磁盘"
      ]
    },
    {
      "title": "监听端口",
      "script": "ss -tulnp",
      "pinned": true,
      "groups": [
        "网络"
      ]
    },
    {
      "title": "连通性测试",
      "script": "ping -c 4 {{host:8.8.8.8}}",
      "groups": [
        "网络"
      ]
    },
    {
      "title": "系统日志尾部",
      "script": "journalctl -n 100 --no-pager",
      "groups": [
        "日志"
      ]
    },
    {
      "title": "容器列表",
      "script": "docker ps -a",
      "groups": [
        "Docker"
      ]
    },
    {
      "title": "容器资源占用",
      "script": "docker stats --no-stream",
      "groups": [
        "Docker"
      ]
    }
  ]
}
