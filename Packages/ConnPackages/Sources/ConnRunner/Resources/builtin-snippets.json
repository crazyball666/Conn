[
  { "title": "系统概览", "command": "uname -a; echo; uptime; echo; free -h", "folder": "系统", "pinned": true },
  { "title": "内存占用 Top 10", "command": "ps -eo pid,comm,pmem --sort=-pmem | head -11", "folder": "系统" },
  { "title": "CPU 占用 Top 10", "command": "ps -eo pid,comm,pcpu --sort=-pcpu | head -11", "folder": "系统" },
  { "title": "登录用户与负载", "command": "who; echo; cat /proc/loadavg", "folder": "系统" },

  { "title": "磁盘使用", "command": "df -h", "folder": "磁盘", "pinned": true },
  { "title": "inode 使用", "command": "df -i", "folder": "磁盘" },
  { "title": "大目录 Top 20", "command": "du -h --max-depth=1 {{path:/}} 2>/dev/null | sort -rh | head -20", "folder": "磁盘" },
  { "title": "大文件定位", "command": "find {{path:/var}} -type f -size +{{size:100M}} -exec ls -lh {} \\; 2>/dev/null", "folder": "磁盘" },
  { "title": "清理 30 天前日志文件", "command": "find {{path:/var/log}} -type f -name '*.log' -mtime +{{days:30}} -delete", "folder": "磁盘", "danger": true },

  { "title": "监听端口", "command": "ss -tulnp", "folder": "网络", "pinned": true },
  { "title": "占用某端口的进程", "command": "ss -tulnp | grep :{{port:80}} || lsof -i :{{port:80}} 2>/dev/null", "folder": "网络" },
  { "title": "连通性测试", "command": "ping -c 4 {{host:8.8.8.8}}", "folder": "网络" },
  { "title": "出口公网 IP", "command": "curl -s ifconfig.me; echo", "folder": "网络" },
  { "title": "连接统计", "command": "ss -s", "folder": "网络" },

  { "title": "系统日志尾部", "command": "journalctl -n 100 --no-pager", "folder": "日志" },
  { "title": "某服务日志", "command": "journalctl -u {{unit:nginx}} -n 100 --no-pager", "folder": "日志" },
  { "title": "内核消息", "command": "dmesg | tail -50", "folder": "日志" },

  { "title": "容器列表", "command": "docker ps -a", "folder": "Docker" },
  { "title": "容器资源占用", "command": "docker stats --no-stream", "folder": "Docker" },
  { "title": "清理无用镜像", "command": "docker image prune -f", "folder": "Docker", "danger": true },

  { "title": "服务状态", "command": "systemctl status {{unit:nginx}} --no-pager", "folder": "服务" },
  { "title": "重启服务", "command": "systemctl restart {{unit:nginx}}", "folder": "服务" }
]
