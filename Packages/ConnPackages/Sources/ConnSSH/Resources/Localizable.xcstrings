        "ko" : { "stringUnit" : { "state" : "translated", "value" : "연결 채널이 닫혔습니다.\n다음 단계: 당겨서 재연결하거나 서버 측 세션이 종료되었는지 확인하세요." } },
        "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "連線通道已關閉。\n下一步：下拉重連，或檢查伺服器端工作階段是否被終止。" } }
