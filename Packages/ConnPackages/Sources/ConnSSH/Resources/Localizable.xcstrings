        "ko" : { "stringUnit" : { "state" : "translated", "value" : "점프 체인이 %d단계(%@)에서 연결에 실패했습니다.\n다음 단계: 해당 단계의 연결성과 자격 증명을 개별적으로 테스트하세요." } },
        "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "跳板鏈在第 %d 級（%@）連線失敗。\n下一步：單獨測試該級跳板機的連通性與憑證。" } }
