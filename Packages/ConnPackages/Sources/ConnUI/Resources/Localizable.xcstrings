    "%@ 不可用，已改用普通终端" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ is unavailable. Switched to a standard terminal."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ を利用できないため、通常のターミナルに切り替えました。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@을(를) 사용할 수 없어 일반 터미널로 전환했습니다."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 無法使用，已切換為一般終端。"
          }
        }
      }
    },
